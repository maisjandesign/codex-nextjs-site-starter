{
  "name": "next-reference-starter",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run check:design",
    "new-project": "node scripts/new-project.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "check:design": "node scripts/check-design-system.mjs",
    "setup": "node scripts/setup-project.mjs",
    "setup:check": "node scripts/setup-project.mjs --check",
    "test:setup": "node --test scripts/skills.test.mjs",
    "graft": "graft",
    "predev": "npm run setup:check",
    "prebuild": "npm run setup:check",
    "prestorybook": "npm run setup:check",
    "prebuild-storybook": "npm run setup:check"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@nanonets/graft": "0.19.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.28",
    "storybook": "10.6.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
